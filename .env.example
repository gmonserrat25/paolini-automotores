# Variables del proyecto de Vercel (Settings → Environment Variables). Ninguna va
# en el código ni en git. DATABASE_URL y BLOB_READ_WRITE_TOKEN las crea Vercel
# solas al conectar la base Neon y el almacén Blob al proyecto.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Texto largo al azar (32 caracteres o más) con el que se firman las sesiones
# del panel: `openssl rand -base64 48`.
SESSION_SECRET=

# api/reconocer.js (reconocimiento de autos por foto con Claude Sonnet 5.5).
ANTHROPIC_API_KEY=
