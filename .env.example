# Acceso al panel (/panel). Se copian de Supabase → Project Settings → API.
# La clave "anon" es pública por diseño; NUNCA pongas acá la "service_role".
# Para desarrollo: copiá este archivo a .env.local con los valores reales.
# Para producción: cargalos como variables del proyecto en Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Función api/reconocer.js (reconocimiento de autos por foto). Sólo en Vercel.
OPENAI_API_KEY=
